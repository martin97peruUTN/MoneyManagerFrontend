# Money Manager backend (Express API) base URL.
#
# Local dev: point at the Express API directly.
# Production (Render): leave VITE_API_URL empty so the browser uses same-origin
# `/api/*`, proxied to the backend via BACKEND_URL in vite.config.ts.
VITE_API_URL=http://localhost:1234

# SSR session lookup. Local dev: same as VITE_API_URL.
# Production with proxy: omit (auto-uses http://127.0.0.1:$PORT).
# API_BASE_URL=http://localhost:1234

# Production only — Nitro proxies /api/** to this backend URL at build time.
# BACKEND_URL=https://your-backend.onrender.com
