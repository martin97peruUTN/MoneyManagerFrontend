# Copy to `.env.local` for local development.
# Production (Render): BACKEND_URL only — leave VITE_API_URL unset.

# Optional in dev (defaults to http://localhost:1234).
# VITE_API_URL=http://localhost:1234

# Production — Nitro proxies /api/** here (set on Render, read at build time).
# BACKEND_URL=https://your-backend.onrender.com
