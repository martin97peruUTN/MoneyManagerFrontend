# Money Manager backend (Express API) base URL.
# Used server-side by the TanStack Start server functions to proxy auth + data.
VITE_API_URL=http://localhost:1234
API_BASE_URL=http://localhost:1234

# Better Auth / session cookie sealing secret.
# Must be at least 32 characters. Generate one with:
#   pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-me-with-a-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
