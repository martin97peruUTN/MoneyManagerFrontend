# Money Manager backend (Express API) base URL.
# The browser talks directly to this origin for Better Auth (/api/auth/*) and
# all data routes, sending the session cookie with credentials: 'include'.
# VITE_API_URL is read in the browser; API_BASE_URL is read by the TanStack
# Start server (SSR session lookup). Keep them in sync.
VITE_API_URL=http://localhost:1234
API_BASE_URL=http://localhost:1234
